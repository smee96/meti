{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meti",
  "compatibility_date": "2026-03-09",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meti-production",
      "database_id": "placeholder-will-be-set-after-db-creation"
    }
  ]
}